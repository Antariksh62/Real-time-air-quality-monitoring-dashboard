# MongoDB Atlas Cloud Database Configuration (Sensitive credentials remain local in .env)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=air_quality_db
MONGO_COLLECTION=aggregated_metrics
ALERTS_COLLECTION=alerts

# Kafka Configuration
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_TOPIC=air_quality_events

# Producer Configuration
DATASET_PATH=data/cpcb_indian_air_quality.csv
PRODUCER_INTERVAL=1.0
FILTER_CITIES=Pune,Mumbai,Delhi
ENABLE_TEST_SPIKES=false
